{
  "name": "tavolo-giochi",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-16",
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*"]},
  "version_metadata": {"binding":"CF_VERSION_METADATA"},
  "durable_objects": {"bindings":[{"name":"ROOMS","class_name":"GameRoom"},{"name":"PROFILES","class_name":"PlayerProfile"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["GameRoom"]},{"tag":"v2","new_sqlite_classes":["PlayerProfile"]}]
}
